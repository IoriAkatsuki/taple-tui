  if (o.z < -4.5 && d.z > 0) {
    z = -4.5;
    side = 1;
  } else if (o.z > 4.5 && d.z < 0) {
    z = 4.5;
    side = 2;
  }
  if (side != 0) {
    float t = (z - o.z) / d.z;
    vec3 q = o + t * d;
    vec2 a = abs(q.xy);
