      roundSD(uv, vec2(76, 48), 3) > -1) {
    float nx = roundSD(uv + vec2(.05, 0), vec2(76, 48), 3) -
               roundSD(uv - vec2(.05, 0), vec2(76, 48), 3);
    float ny = roundSD(uv + vec2(0, .05), vec2(76, 48), 3) -
               roundSD(uv - vec2(0, .05), vec2(76, 48), 3);
    vec2 n = length(vec2(nx, ny)) == 0 ? vec2(0, -1) : normalize(vec2(nx, ny));
    return faceAt(m.shell, normalize(vec3(n * .7, .7)), .6, 3);
  }
  for (int i = 0; i < 2; i++) {
    vec2 d = uv - vec2(i == 0 ? 3.6 : 72.4, 44.4);
    if (dot(d, d) < 1.3)
      return faceAt(m.screw, normalize(vec3(d, 1.2)), .8, 3);
  }
  float dw = windowDist(uv);
  if (dw <= 8.5)
    return faceAt(vec3(0), vec3(0), 0, 2);
  if (dw <= 9.4) {
    vec2 n = (uv - vec2(clamp(u, 22, 54), 24)) / dw;
    return faceAt(m.shell * .9, normalize(vec3(-n * .5, .85)), .5, 3);
  }
  bool label = roundSD(uv - vec2(4, 3), vec2(68, 32), 1.5) <= 0;
  if (m.pattern == 4)
    label = u >= 14 && u <= 62 && v >= 4 && v <= 14;
  if (label)
    return labelAt(uv, m, side, detail);
  if (v >= 37) {
    float spread = (v - 37) * 4 / 11;
    if (u >= 20 - spread && u <= 56 + spread) {
      if (length(uv - vec2(26.5, 44)) < 1.4 ||
          length(uv - vec2(49.5, 44)) < 1.4 || u >= 35 && u <= 41 && v >= 44.5)
        return faceAt(m.hole, vec3(0, 0, 1), 0, 3);
      if (v < 38)
        return faceAt(m.shell, vec3(0, -.6, .8), .5, 3);
      return faceAt(m.shell * 1.05, vec3(0, 0, 1), .35, 3);
    }
