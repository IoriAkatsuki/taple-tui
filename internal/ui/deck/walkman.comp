}
const int digits[70] =
    int[](14, 17, 19, 21, 25, 17, 14, 4, 12, 4, 4, 4, 4, 14, 14, 17, 1, 2, 4, 8,
          31, 30, 1, 1, 14, 1, 1, 30, 2, 6, 10, 18, 31, 2, 2, 31, 16, 16, 30, 1,
          1, 30, 14, 16, 16, 30, 17, 17, 14, 31, 1, 2, 4, 8, 8, 8, 14, 17, 17,
          14, 17, 17, 14, 14, 17, 17, 15, 1, 1, 14);
bool trackInk(vec2 uv) {
  vec2 q = uv - vec2(56, 4.5);
  int idx = int(floor(q.x / 7)), col = int(floor(q.x - float(idx) * 7)),
      row = int(floor(q.y / (5.5 / 7)));
  if (idx < 0 || idx > 1 || col < 0 || col >= 5 || row < 0 || row >= 7)
    return false;
  int number = (int(p[47]) % 100 + 100) % 100,
      digit = idx == 0 ? number / 10 : number % 10;
  return (digits[digit * 7 + row] & (1 << (4 - col))) != 0;
