      vec2 q = (uv - vec2(6.6, 3.9)) / 1.05;
      if (q.x >= 0 && q.y >= 0 && q.x < 5 && q.y < 7) {
        int row = int(q.y);
        int a[7] = int[](14, 17, 17, 31, 17, 17, 17);
        int b[7] = int[](30, 17, 17, 30, 17, 17, 30);
