    if (r < 6.5) {
      vec3 c = m.hub;
      if (r > 5.7 || r < 3.8)
        c *= .87;
      if (r > 4.2 && r < 5.9 && nearAngle(rel, PI, 2 * PI, .32))
        return mix(c, m.clampColor, 1 - .9 * blur);
      return c;
    }
    vec3 c = m.tape * (1 + .05 * sin(r * 2.6));
    float dd = mod(abs(a + 2.2), 2 * PI), s = min(dd, 2 * PI - dd);
