    vec3 n = crot * vec3(0, 0, -dir), r = reflect(-view, n);
    float az = atan(r.x, -r.z), reflectionQ = (az - .6) / .07,
          band = exp(-reflectionQ * reflectionQ) * smoothstep(-.9, -.2, -r.y);
    return mix(mix(c, m.glass, .12), m.hero, .2 * band);
  }
  vec3 n = side == 0 ? vec3(f.normal.xy, -f.normal.z)
                     : vec3(-f.normal.x, f.normal.yz);
  vec3 c = light(f.color, n, view, f.gloss, crot, m.hero);
  if (f.kind == 1 && m.translucent > 0) {
    vec3 q = o + d * ((z + dir * 3 - o.z) / d.z);
    c = mix(c, interior(q.xy, m), m.translucent);
