float copySign(float a, float b) { return b < 0 ? -abs(a) : abs(a); }
bool slab(float o, float d, float lo, float hi, out float a, out float b) {
  if (abs(d) < 1e-12) {
    a = -INF;
    b = INF;
    return o >= lo && o <= hi;
  }
  a = (lo - o) / d;
  b = (hi - o) / d;
  if (a > b) {
    float c = a;
    a = b;
    b = c;
  }
