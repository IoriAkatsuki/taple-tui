vec3 cassette(vec3 o, vec3 d, vec3 view, Hit h, Mat m) {
  if (h.side == 3) {
    vec3 c = m.shell;
    if (abs(h.point.z) < .3)
      c *= .8;
    return light(c, h.normal, view, .3, crot, m.hero);
  }
  int side = h.side == 2 ? 1 : 0;
  float dir = side == 0 ? 1 : -1, z = side == 0 ? -4.5 : 4.5;
  vec2 uv = vec2(side == 0 ? h.point.x + 38 : 38 - h.point.x, h.point.y + 24);
  Face f = face(uv, m, side, p[39]);
  if (f.kind == 2) {
    vec3 q = o + d * ((z + dir * 3 - o.z) / d.z);
    vec2 v = q.xy + vec2(38, 24);
    vec3 c;
    if (windowDist(v) > 8.5) {
      vec2 n = v - vec2(clamp(v.x, 22, 54), 24);
      n = -normalize(n);
      c = light(m.shell * .95, vec3(n, 0), view, .2, crot, m.hero);
    } else {
      bool glass;
      c = reel(q.xy, m, glass);
      vec3 l = transpose(crot) * lamp;
      if (abs(l.z) > 1e-6) {
        vec3 sh = q + l * ((z - q.z) / l.z);
        float over = windowDist(sh.xy + vec2(38, 24)) - 8.5;
        if (over > 0)
          c *= 1 - .42 * min(over / .8, 1);
