  if (abs(q.x) > 35 && abs(q.y) > 21) {
    vec2 c = vec2(copySign(35, q.x), copySign(21, q.y));
    float a, b;
    if (!circle(o.xy, d.xy, c, 3, a, b))
      return false;
    t0 = a;
    normal = (o.xy + a * d.xy - c) / 3;
  }
  q = o.xy + t1 * d.xy;
  if (abs(q.x) > 35 && abs(q.y) > 21) {
    float a, b;
    if (!circle(o.xy, d.xy, vec2(copySign(35, q.x), copySign(21, q.y)), 3, a,
                b))
      return false;
    t1 = b;
