    float a, b;
    if (!slab(o[i], d[i], lo[i], hi[i], a, b))
      return false;
    if (a > enter) {
      enter = a;
      n = vec3(0);
      n[i] = -copySign(1, d[i]);
    }
    leave = min(leave, b);
  }
  if (enter <= 0 || enter > leave)
    return false;
  h = Hit(enter, o + enter * d, n, 3);
