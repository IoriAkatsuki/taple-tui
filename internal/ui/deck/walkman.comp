}
float roundSD(vec2 uv, vec2 wh, float r) {
  vec2 q = abs(uv - wh / 2) - (wh / 2 - r);
  return length(max(q, 0)) + min(max(q.x, q.y), 0) - r;
}
float windowDist(vec2 uv) { return length(uv - vec2(clamp(uv.x, 22, 54), 24)); }
vec3 light(vec3 albedo, vec3 n, vec3 view, float gloss, mat3 rotation,
