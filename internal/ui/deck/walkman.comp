vec3 interior(vec2 xy, Mat m) {
  vec2 uv = xy + vec2(38, 24);
  for (int i = 0; i < 2; i++) {
    float r = length(uv - vec2(i == 0 ? 10 : 66, 40));
    if (r < 3.2)
      return r < 1 ? m.hole : m.hub * (.8 + .2 * r / 3.2);
  }
  if (abs(uv.y - 37) < .6)
    return m.shell * .7;
  bool glass;
  vec3 c = reel(xy, m, glass);
  if (!glass)
    return c;
  for (int i = 0; i < 2; i++) {
    vec2 q = xy - vec2(i == 0 ? -16 : 16, 0);
    if (length(q) < 15.8) {
      vec3 plate = mix(m.glass, m.hub, .18);
      return nearAngle(atan(q.y, q.x) - p[42 + i], 0, 2 * PI / 3, .22)
                 ? mix(m.glass, plate, p[44])
                 : plate;
    }
  }
