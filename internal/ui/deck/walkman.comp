    if (detail >= .5) {
      if (m.pattern == 1 && (abs(u - 18 + (v - 14) * 1.4) < 1.8 ||
                             abs(u - 26 + (v - 14) * 1.4) < 1.1))
        c = m.ink;
      if (m.pattern == 2) {
        if (v >= 10 && v <= 15)
          c = m.ink;
        else if (v < 10 && (mod(u, 6) < .7 || mod(v, 2.5) < .7))
          c = m.shell;
      }
      if (m.pattern == 3) {
        if (v >= 10.5 && v <= 13.5)
          c = m.shell;
        else if (u >= 56 && u <= 68 && v >= 4.5 && v <= 10 && trackInk(uv))
          c = m.ink;
      }
      if (m.pattern == 4) {
        if (v >= 11 && v < 11.9)
          c = vec3(255, 59, 92);
        else if (v >= 11.9 && v < 12.8)
          c = vec3(255, 210, 63);
        else if (v >= 12.8 && v <= 13.7)
          c = m.ink;
